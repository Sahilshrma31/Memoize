# Leave unset for local dev (Vite proxies /api to localhost:5050).
# In production set to your deployed API base, e.g. https://memoize-api.onrender.com/api
VITE_API_URL=

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Same value as the server's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
