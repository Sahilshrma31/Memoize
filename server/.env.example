MONGODB_URI=mongodb://127.0.0.1:27017/memoize
PORT=5050

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# --- AI-graded recall (entirely optional) --------------------------------
# Leave every line below blank and the feature turns itself off. Everything
# else works as normal and the server still boots.
#
# Free option, no billing account needed — https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Paid alternative — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
#
# Only needed if you set BOTH keys. Without it Claude wins. One of: gemini, claude
RECALL_PROVIDER=
